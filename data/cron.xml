<odoo>
    <record id="cron_auto_update_match_state" model="ir.cron">
        <field name="name">Auto Update Played Matches</field>
        <field name="model_id" ref="model_football_match"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_update_played()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>